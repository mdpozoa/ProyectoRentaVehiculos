FROM node:20-bookworm

# 1. Instalar Nginx, RabbitMQ y Supervisor
RUN apt-get update && apt-get install -y nginx rabbitmq-server supervisor && rm -rf /var/lib/apt/lists/*

# 2. Configurar Nginx
COPY nginx/nginx.conf /etc/nginx/nginx.conf
# En este monolito, los upstreams apuntan a localhost en vez de nombres de contenedor
RUN sed -i 's/auth-service:3001/127.0.0.1:3001/g' /etc/nginx/nginx.conf && \
    sed -i 's/inventario-service:3002/127.0.0.1:3002/g' /etc/nginx/nginx.conf && \
    sed -i 's/org-service:3003/127.0.0.1:3003/g' /etc/nginx/nginx.conf && \
    sed -i 's/operaciones-service:3004/127.0.0.1:3004/g' /etc/nginx/nginx.conf && \
    sed -i 's/financiero-service:3005/127.0.0.1:3005/g' /etc/nginx/nginx.conf && \
    sed -i 's/mantenimiento-service:3006/127.0.0.1:3006/g' /etc/nginx/nginx.conf && \
    sed -i 's/bus-service:3007/127.0.0.1:3007/g' /etc/nginx/nginx.conf && \
    sed -i 's/resolver 127.0.0.11/# resolver 127.0.0.11/g' /etc/nginx/nginx.conf

# 3. Preparar directorio de la aplicación
WORKDIR /app

# 4. Copiar package.json global y prisma
COPY package.json package-lock.json ./
COPY proto ./proto/

# 5. Instalar dependencias globales y de todos los servicios
COPY services/auth-service/package.json ./services/auth-service/
COPY services/inventario-service/package.json ./services/inventario-service/
COPY services/org-service/package.json ./services/org-service/
COPY services/operaciones-service/package.json ./services/operaciones-service/
COPY services/financiero-service/package.json ./services/financiero-service/
COPY services/mantenimiento-service/package.json ./services/mantenimiento-service/
COPY services/bus-service/package.json ./services/bus-service/

# Instalar dependencias de cada servicio
RUN cd services/auth-service && npm install
RUN cd services/inventario-service && npm install
RUN cd services/org-service && npm install
RUN cd services/operaciones-service && npm install
RUN cd services/financiero-service && npm install
RUN cd services/mantenimiento-service && npm install
RUN cd services/bus-service && npm install

# 6. Copiar el código fuente completo
COPY services ./services/

# 7. Generar Prisma y compilar TypeScript en cada servicio
RUN cd services/auth-service && npx prisma generate && npx tsc
RUN cd services/inventario-service && npx prisma generate && npx tsc
RUN cd services/org-service && npx prisma generate && npx tsc
RUN cd services/operaciones-service && npx prisma generate && npx tsc
RUN cd services/financiero-service && npx prisma generate && npx tsc
RUN cd services/mantenimiento-service && npx prisma generate && npx tsc
RUN cd services/bus-service && npx tsc

# 8. Copiar y construir el Frontend Vue (Opcional si usas el nginx para servir estáticos)
# Aquí asumimos que ya tienes una build o que Render no necesita el frontend en este contenedor. 
# Si necesitas compilar el frontend aquí, añade los comandos de vite build.
COPY admin-dashboard/dist* /usr/share/nginx/html/

# 9. Configurar Supervisord
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Exponer el puerto 80 para Render
EXPOSE 80

# Ejecutar Supervisord
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
